{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "datasource",
  "name": "KWDB TSDB",
  "id": "lumingsun-kwdbtsdb-datasource",
  "metrics": true,
  "alerting": true,
  "annotations": true,
  "backend": true,
  "executable": "gpx_kwdb_tsdb_datasource",
  "category": "tsdb",
  "info": {
    "description": "Connect Grafana to KaiwuDB and KWDB time-series engines. Query, visualize, and analyze time-series data with a visual SQL builder or raw SQL.",
    "author": {
      "name": "Kaiwudb",
      "url": "https://www.kaiwudb.com"
    },
    "keywords": [
      "datasource",
      "time series",
      "TSDB",
      "SQL",
      "KWDB",
      "KaiwuDB"
    ],
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "GitHub",
        "url": "https://github.com/LumingSun/KWDB-Grafana-Plugin"
      },
      {
        "name": "Documentation",
        "url": "https://www.kaiwudb.com"
      },
      {
        "name": "Support",
        "url": "https://github.com/LumingSun/KWDB-Grafana-Plugin/issues"
      },
      {
        "name": "License",
        "url": "https://github.com/LumingSun/KWDB-Grafana-Plugin/blob/master/LICENSE"
      }
    ],
    "screenshots": [
      {
        "name": "KWDB TSDB query editor",
        "path": "img/screenshot-query-editor.png"
      },
      {
        "name": "Dashboard built on the KWDB TSDB data source",
        "path": "img/example.png"
      },
      {
        "name": "Data source configuration",
        "path": "img/kwdb-datasource.png"
      },
      {
        "name": "Downsampling query with the SQL builder",
        "path": "img/downsampling-example.png"
      },
      {
        "name": "Save and test health check",
        "path": "img/save-test.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": {
    "grafanaDependency": ">=13.1.0",
    "plugins": []
  }
